# --- Meta ---------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=

# Long-lived user token with: ads_read, ads_management, business_management,
# pages_read_engagement, pages_show_list. Graph API Explorer tokens last ~1h;
# exchange for 60 days:
#   GET /oauth/access_token?grant_type=fb_exchange_token
#       &client_id=<APP_ID>&client_secret=<APP_SECRET>&fb_exchange_token=<SHORT>
META_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0

# Restrict the account picker (comma separated, act_ prefix). Empty = all.
META_ALLOWED_ACCOUNTS=

# --- Dashboard login ----------------------------------------------------
# Required. Without all three, login returns 503 rather than defaulting open.
# DASHBOARD_PASSWORD accepts a bcrypt hash (starts with $2) or plain text.
#   python -c "import bcrypt;print(bcrypt.hashpw(b'yourpass',bcrypt.gensalt()).decode())"
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_HOURS=12
# Keep false for local HTTP. Docker deployment sets this to true behind HTTPS.
SESSION_COOKIE_SECURE=false

# --- Strategist (OpenAI) ------------------------------------------------
# Powers the Strategist chat. Get one at platform.openai.com/api-keys.
# Without it every other page still works; only the chat is disabled, and it
# says so rather than failing silently.
OPENAI_API_KEY=
# Any chat model that supports function calling. Change without touching code.
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VIDEO_MODEL=sora-2
# Idea generator (reasoning model).
OPENAI_CREATIVE_MODEL=gpt-5.5

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
